{
  "name": "dotbox-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run build:css && npm run build:js && npm run build:static",
    "build:css": "sass --no-source-map .:dist",
    "build:js": "tsc",
    "build:static": "node scripts/build-static.js",
    "watch:css": "sass --no-source-map --watch .:dist",
    "watch:js": "tsc --watch",
    "dev": "npm run watch:css & npm run watch:js"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "typescript": "^5.5.0"
  }
}
