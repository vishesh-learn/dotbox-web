{
  "name": "dotbox-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "build": "npm run build:css && npm run build:js && npm run build:static",
    "build:css": "sass --no-source-map common/css:dist/common/css pages:dist/pages main.scss:dist/main.css",
    "build:js": "tsc",
    "build:static": "node scripts/build-static.js",
    "watch:css": "sass --watch common/css:dist/common/css pages:dist/pages main.scss:dist/main.css",
    "watch:js": "tsc --watch",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"browser-sync start --server . --files 'dist/**,pages/**/*.html,*.html' --no-notify --no-open\"",
    "preview": "npx serve dist"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "sass": "^1.77.0",
    "typescript": "^5.5.0"
  }
}
